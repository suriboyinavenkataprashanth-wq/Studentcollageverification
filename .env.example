# CollegeCompass AP - Environment Configuration
# Copy this file to .env.local and populate credentials when connecting real Supabase

# Supabase Credentials (PostgreSQL DB, Authentication, Storage)
# Leave empty or omit to run in interactive Demo / Local mode with persistent browser storage
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Application Settings
VITE_APP_NAME="CollegeCompass AP"
VITE_ROUTING_PROVIDER="OSRM_OPENSTREETMAP"
VITE_ENABLE_ANALYTICS=false
